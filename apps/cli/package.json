{
  "name": "@tackup/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for managing cross-agent resources from registered sources.",
  "license": "MIT",
  "bin": {
    "tack": "./dist/main.js"
  },
  "type": "module",
  "exports": {
    "./core": "./src/bootstrap/core.ts",
    "./test/file-system-contract": "./test/support/file-system-contract.ts"
  },
  "scripts": {
    "build": "bun build ./src/main.ts --outdir ./dist --target bun --external '@tackup/reader/*' && bun build ./src/platform/execution/worker.ts --outfile ./dist/worker.js --target bun && rm -rf ./dist/builtins && cp -R ./src/builtins ./dist/builtins && chmod +x ./dist/main.js",
    "start": "bun run ./src/main.ts",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@effect/platform-node-shared": "catalog:",
    "@rspack/core": "2.3.2",
    "@tackup/core": "workspace:*",
    "@tackup/reader": "workspace:*",
    "effect": "catalog:",
    "parse5": "7.3.0",
    "picomatch": "4.0.7",
    "remark-frontmatter": "5.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@types/picomatch": "4.0.2"
  }
}
