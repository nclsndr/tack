    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@mdx-js/react": "3.1.1",
    "@rsbuild/core": "2.3.2",
    "@rspack/core": "2.3.2",
    "@rspress/core": "2.1.3",
    "@tailwindcss/postcss": "4.3.3",
    "acorn": "8.19.0",
    "elkjs": "0.12.1",
    "esbuild": "0.25.12",
    "lucide-react": "^1.59.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "picomatch": "4.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "4.3.3",
    "unified": "^11.0.5",
    "yaml": "^2.8.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/estree": "1.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/mdast": "^4.0.4",
    "@types/picomatch": "4.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.0.1",
    "react-render-to-markdown": "19.1.0"
