{
  "name": "@tackup/reader",
  "version": "0.1.0",
  "private": true,
  "description": "Reader and search for docs managed as cross-agent resources by Tack.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/visuals.tsx",
    "./server": "./src/server.ts",
    "./runtime": "./src/runtime.tsx",
    "./search": "./src/search-entry.ts",
    "./search-core": "./src/search.ts",
    "./source-edges": "./src/source-edges.ts",
    "./figure-check": "./src/figures/check.ts",
    "./icons": "./src/icons/catalog.ts",
    "./figure-reference": "./src/figures/reference.ts"
